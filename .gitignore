# secrets and generated credentials — never commit these
.env
.env.local
.env.*.local
*.pem
*.key

# machine-specific compose overrides (e.g. local port remaps) — not
# project truth, would mislead anyone else running this repo
docker-compose.override.yml

# python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# node / frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# ide
.vscode/
.idea/
.DS_Store

# local data volumes if bind-mounted
data/
*.db
