# Copy to .env.local — these are all PUBLIC (NEXT_PUBLIC_) values baked
# into the client bundle. Never put a secret in a NEXT_PUBLIC_ variable;
# the attestor-frontend Keycloak client is a public client specifically
# so nothing secret needs to live here.

NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=attestor
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=attestor-frontend

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
