# Copy this to .env, fill in the two API keys, then run scripts/bootstrap.sh
# .env.local (Keycloak user passwords) is generated automatically — do not create it by hand.

POSTGRES_PASSWORD=attestor_local_dev_only
KEYCLOAK_DB_PASSWORD=keycloak_local_dev_only
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev_only
MINIO_ROOT_USER=attestor_admin
MINIO_ROOT_PASSWORD=attestor_local_dev_only

# Required — get a free key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Required — get a free key at https://console.groq.com
GROQ_API_KEY=

# Which provider runs the second/independent judge. groq | ollama | openai
JUDGE_PROVIDER=groq
